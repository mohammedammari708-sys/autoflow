# AutoFlow API — environment variables.
# Copy to `.env` (never commit a real `.env`):
#   cp .env.example .env
# JWT_SECRET and ENCRYPTION_KEY are REQUIRED in production — the server
# refuses to start without them. In development they are auto-generated
# per run (ephemeral) with a loud console warning when unset.

# Port the API listens on.
PORT=4000

# SQLite database file (relative paths resolve from apps/api/).
DATABASE_URL=./data/autoflow.db

# Secret for signing JWTs (HS256, 7-day expiry). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of stored
# credentials. Generate one with the same command as JWT_SECRET.
ENCRYPTION_KEY=

# Frontend origin allowed by CORS (credentials enabled).
WEB_ORIGIN=http://localhost:5173

# SameSite for the auth cookie: lax (default, same-origin deploys) |
# strict | none. Split deployments (frontend and API on different
# domains, e.g. Netlify + Render) REQUIRE none — otherwise the browser
# will not send the login cookie to the API and every request returns
# 401. SameSite=None forces Secure (HTTPS) automatically.
COOKIE_SAMESITE=lax

# development | production
NODE_ENV=development
