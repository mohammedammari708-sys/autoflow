# AutoFlow web — build-time environment variables.
# Copy to `.env` (never commit a real `.env`):
#   cp .env.example .env

# Absolute URL of the API, baked into the build. Only needed for SPLIT
# deployments where the frontend and the API live on different domains
# (e.g. Netlify site + Render API):
#   VITE_API_URL=https://autoflow-api.onrender.com
# Leave it empty for same-origin deployments (dev, docker-compose):
# the app then calls relative /api paths.
# A bare host without https:// also works (https:// is added).
VITE_API_URL=
